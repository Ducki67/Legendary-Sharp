<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Legendary_Sharp</RootNamespace>
    <AssemblyName>LegendarySharp</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <Version>1.0.0</Version>
    <Product>Legendary Sharp</Product>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <PublishAfterBuild Condition="'$(PublishAfterBuild)' == ''">true</PublishAfterBuild>
    <NativeRuntimeIdentifier Condition="'$(NativeRuntimeIdentifier)' == ''">win-x64</NativeRuntimeIdentifier>
    <ReleaseFolder>$([System.IO.Path]::GetFullPath($(MSBuildProjectDirectory)\..\publish))</ReleaseFolder>
  </PropertyGroup>

  <Target Name="PublishNative" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'
                     And '$(PublishAfterBuild)' == 'true'
                     And '$(NativePublishPass)' != 'true'
                     And '$(_IsPublishing)' != 'true'">

    <PropertyGroup>
      <NativeExe>$(OutputPath)$(NativeRuntimeIdentifier)\publish\$(AssemblyName).exe</NativeExe>
      <VsInstallerDir>$([System.Environment]::GetFolderPath(SpecialFolder.ProgramFilesX86))\Microsoft Visual Studio\Installer</VsInstallerDir>
      <NativePublishCommand>set "PATH=%25PATH%25;$(VsInstallerDir)" &amp;&amp; dotnet publish "$(MSBuildProjectFullPath)" -c $(Configuration) -r $(NativeRuntimeIdentifier) -p:NativePublishPass=true -p:Version=$(Version) --nologo</NativePublishCommand>
    </PropertyGroup>

    <Message Importance="high" Text="Release build finished, publishing the native single file exe..." />

    <Delete Files="$(NativeExe)" ContinueOnError="true" />

    <PropertyGroup>
      <NativeExeLocked Condition="Exists('$(NativeExe)')">true</NativeExeLocked>
    </PropertyGroup>

    <Exec Command="$(NativePublishCommand)"
          Condition="'$(NativeExeLocked)' != 'true'"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="true"
          StandardOutputImportance="low" />

    <Copy SourceFiles="$(NativeExe)"
          DestinationFolder="$(ReleaseFolder)"
          Condition="'$(NativeExeLocked)' != 'true' And Exists('$(NativeExe)')"
          ContinueOnError="true" />

    <Message Importance="high"
             Condition="'$(NativeExeLocked)' != 'true' And Exists('$(NativeExe)')"
             Text="Native exe ready: $(ReleaseFolder)\$(AssemblyName).exe" />

    <Error Condition="'$(NativeExeLocked)' == 'true'"
           Text="$(NativeExe) is running, so the new exe could not be written. Close every LegendarySharp window and build again. Nothing in $(ReleaseFolder) was touched, so it still holds the previous build." />

    <Warning Condition="'$(NativeExeLocked)' != 'true' And !Exists('$(NativeExe)')"
             Text="Skipped the native publish. It needs the Visual Studio C++ build tools. The managed build in $(OutputPath) is fine. Use -p:PublishAfterBuild=false to silence this." />
  </Target>

</Project>
